{
  "name": "hackernews-qwik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr --port 3003",
    "build": "vite build && vite build -c adapters/vercel-edge/vite.config.ts",
    "build.preview": "vite build && vite build --ssr src/entry.preview.tsx",
    "preview": "vite preview --port 3003",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@repo/hn-core": "workspace:*",
    "@repo/hn-styles": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
