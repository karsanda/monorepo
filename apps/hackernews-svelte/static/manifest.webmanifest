{
  "name": "Hacker News - Svelte",
  "short_name": "HN Svelte",
  "description": "Hacker News reader built with SvelteKit",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#282c34",
  "theme_color": "#ff3e00",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
