{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "metrics": "pnpm --filter @repo/metrics metrics"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "turbo": "^2.11.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
