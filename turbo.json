{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".svelte-kit/**",
        ".vercel/**",
        ".next/**",
        "!.next/cache/**",
        ".output/**",
        "server/**"
      ]
    },
    "hackernews-nuxt#build": {
      "dependsOn": ["^build", "hackernews-nuxt#typecheck", "hackernews-nuxt#test"],
      "outputs": [".output/**", ".vercel/**"]
    },
    "landing#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/metrics/metrics.json"],
      "outputs": ["dist/**"],
      "env": ["LANDING_URL_*"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
